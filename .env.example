# ============================================================
# FOOD SOUL 服务端环境变量示例（只放占位值，不要提交真实密钥）
# ============================================================

# 用户级 AI 配置加密密钥：32 字节，base64 或 64 位 hex
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CONFIG_SECRET=replace-with-32-byte-base64-secret
# 密钥轮换时用于解密旧版本（可选）
AI_CONFIG_SECRET_PREVIOUS=
AI_CONFIG_KEY_VERSION=1

# 联网检索服务（与用户自己的聊天模型分开）
# 菜谱「真实来源检索」与图鉴「AI 补全菜品」依赖它；未配置时相关功能会明确提示，不伪造来源。
# 联网检索服务：zhipu（智谱 Web Search）| searxng（自建元搜索，免费）
SEARCH_PROVIDER=zhipu
# searxng 模式下填实例地址；zhipu 模式下填 API Key
SEARXNG_URL=http://127.0.0.1:8080
SEARCH_API_KEY=
SEARCH_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 登录会话有效期（天）
SESSION_TTL_DAYS=7

# 生产静态服务端口（npm start）
PORT=5190

# 说明：
# - 不再提供默认的模型 API Key / 模型名；模型由每个登录用户在右上角「接入 AI」中自行配置。
# - SEARCH_API_KEY 只用于独立联网检索，不会作为用户的聊天模型密钥。

# 管理员白名单：逗号分隔的邮箱，命中者登录后即为管理员（只从服务端读取）
ADMIN_EMAILS=you@example.com
