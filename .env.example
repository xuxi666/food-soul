# ============================================================
# 食有灵 · FOOD SOUL 服务端环境变量模板
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，禁止提交真实密钥
# ============================================================

# 必填：用户级 AI Key 的 AES-256-GCM 加密密钥。
# 必须是 32 字节（64 位 hex 或 base64），丢失后已保存的 Key 无法解密。
# 生成：node --input-type=module -e "import c from 'node:crypto'; console.log(c.randomBytes(32).toString('base64'))"
AI_CONFIG_SECRET=replace-me-with-32-byte-base64-secret
# 可选：密钥轮换期间用于解密旧密文；轮换完成并确认旧数据迁移后可删除
AI_CONFIG_SECRET_PREVIOUS=
# 可选：当前密钥版本，默认 1
AI_CONFIG_KEY_VERSION=1

# 生产服务端端口；npm start 默认 127.0.0.1:5190
PORT=5190
# 可选：生产环境再设为 production（本地开发留空）；production 时 Cookie 强制 Secure
NODE_ENV=
# 可选：SQLite 文件路径；默认 <项目根>/data/foodsoul.db
DB_PATH=./data/foodsoul.db
# 可选：登录会话有效期（天），服务端限制在 1–30 天
SESSION_TTL_DAYS=7
# 可选：管理员邮箱白名单，逗号分隔；命中者登录后自动成为 admin
ADMIN_EMAILS=you@example.com

# ---------------- 联网检索（可选，失败时降级） ----------------
# 当前检索链路：自建 SearXNG → 360 搜索 → Bing RSS，不需要付费检索 Key。
# SEARXNG_URL 未配置或不可用时，仍会尝试 360 / Bing。
# 检索链路不需要任何 API Key；旧版 SEARCH_PROVIDER / SEARCH_API_KEY /
# SEARCH_BASE_URL 已不再读取，可安全删除。
SEARXNG_URL=http://127.0.0.1:8080
# 可选：覆盖检索端点；显式设为空串可关闭对应来源
BING_RSS_URL=https://cn.bing.com/search
SO360_URL=https://www.so.com/s

# ---------------- Epicure 风味服务（可选） ----------------
# 关闭后厨房的风味图谱/配方功能整体降级，聊天、菜谱、推荐仍可用
EPICURE_ENABLED=true
EPICURE_MCP_URL=https://epicure-mcp.kaikaku.ai/mcp
EPICURE_TIMEOUT_MS=10000
EPICURE_CACHE_TTL_MS=300000
EPICURE_MAX_CONCURRENCY=3
# 可选：Epicure 食材目录地址
EPICURE_CATALOG_URL=https://epicure.kaikaku.ai/api/ingredients

# ---------------- 仅本地验证脚本使用（不是服务端配置） ----------------
# 不要把生产管理员密码写入这里；测试账号请使用专用本地账号。
# BASE=http://127.0.0.1:5180
# ADMIN_EMAIL=admin@foodsoul.local
# ADMIN_PASS=

# 说明：
# 1. 站点不内置模型 API Key；用户在「接入 AI」中配置自己的 OpenAI 兼容服务。
# 2. 缺少 AI_CONFIG_SECRET 时仍可浏览，但保存 AI 配置会明确失败。
# 3. 缺少 SEARXNG_URL 时检索自动尝试 360 / Bing，不伪造来源。